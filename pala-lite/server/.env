# Copy this file to ".env" and fill it in.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Must match DEVICE_TOKEN in firmware/PalaLite/config.h
DEVICE_TOKEN=change-me

# Text AI used to organise notes and write briefings: "gemini" (free) or "cerebras"
TEXT_LLM=gemini
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Models (change these if Google renames them)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VOICE=Kore

TIMEZONE=Asia/Kolkata
LANGUAGE=English
